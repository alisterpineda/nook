<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Nook.ServiceDefaults\Nook.ServiceDefaults.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Npgsql.EntityFrameworkCore.PostgreSQL" Version="13.6.5" />
    <PackageReference Include="EFCore.NamingConventions" Version="10.0.1" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.15" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.15" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.15" PrivateAssets="all" />
    <PackageReference Include="SkiaSharp" Version="4.156.0" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.156.0" />
    <PackageReference Include="VersOne.Epub" Version="3.3.6" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- A build that recompiles the API rewrites openapi.json beside this file, where the web app reads it to
       generate its types. An up-to-date build skips it, so a deleted openapi.json needs a rebuild. -->
  <PropertyGroup>
    <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOptions>--file-name openapi</OpenApiGenerateDocumentsOptions>
  </PropertyGroup>

  <!-- Publishing builds the web app and puts it in the output's wwwroot, so a published API is the whole app.
       This runs only during publish: an ordinary build or test run never calls npm.
       SkipWebAppBuild=true publishes the web app that is already built, without calling npm. It is for a
       publish that runs this target more than once at the same time, as one for several architectures does. -->
  <Target Name="PublishWebApp" AfterTargets="ComputeFilesToPublish">
    <PropertyGroup>
      <WebAppDirectory>$(MSBuildProjectDirectory)/../Nook.Web/</WebAppDirectory>
    </PropertyGroup>
    <Exec WorkingDirectory="$(WebAppDirectory)" Command="npm ci" Condition="'$(SkipWebAppBuild)' != 'true'" />
    <Exec WorkingDirectory="$(WebAppDirectory)" Command="npm run build" Condition="'$(SkipWebAppBuild)' != 'true'" />
    <Error Condition="!Exists('$(WebAppDirectory)dist/nook-web/browser/index.html')" Text="The web app is not built. Run npm ci and npm run build in src/Nook.Web, or publish without SkipWebAppBuild." />
    <ItemGroup>
      <WebAppFile Include="$(WebAppDirectory)dist/nook-web/browser/**" />
      <ResolvedFileToPublish Include="@(WebAppFile->'%(FullPath)')" Exclude="@(ResolvedFileToPublish)">
        <RelativePath>wwwroot/%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

  <!-- The container image keeps its files in /data, where a volume is mounted. -->
  <ItemGroup>
    <ContainerEnvironmentVariable Include="Nook__DataPath" Value="/data" />
  </ItemGroup>

</Project>
